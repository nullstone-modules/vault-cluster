[Unit]
Description=Vault raft snapshots
# Ordered after bootstrap but not bound to it, for the same reason as vault-health.service.
Requires=vault.service
After=vault.service vault-bootstrap.service

[Service]
EnvironmentFile=/etc/vault.d/vault-utils.env
EnvironmentFile=/etc/vault.d/node.env
ExecStart=/usr/local/bin/vault-utils snapshot schedule
# An empty BACKUP_SCHEDULE exits 0, which leaves this unit stopped instead of looping.
Restart=on-failure
RestartSec=30
User=vault
Group=vault

[Install]
WantedBy=multi-user.target
